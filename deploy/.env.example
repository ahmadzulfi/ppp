# Salin ke deploy/.env lalu isi. File itu tidak pernah di-commit.
# Alamat antar-layanan (REDIS_URL, AI_KNOWLEDGE_URL, dst.) sudah disusun di
# compose.yml - tidak perlu diisi di sini.

# ---------- Domain ----------
# Subdomain yang diarahkan ke server ini, tanpa https:// dan tanpa garis miring.
# Dipakai untuk AUTH_URL dan callback webhook Meta (https://DOMAIN/webhooks/...).
DOMAIN="wa.contoh.go.id"

# ---------- Database ----------
# Postgres berjalan di container "postgres" di server ini (profil db-lokal).
# Datanya disimpan di volume Docker pgdata.
COMPOSE_PROFILES=db-lokal
# openssl rand -hex 24 (cukup huruf dan angka). Hanya dibaca saat volume
# pgdata pertama kali dibuat - jangan diganti setelah itu.
POSTGRES_PASSWORD=""

# Ganti PASSWORD di kedua URL dengan POSTGRES_PASSWORD di atas. Host
# "postgres" adalah nama container, bukan localhost.
#
# Dipakai web, webhook, worker, dan migrasi (Prisma). Boleh membawa
# parameter Prisma seperti connection_limit.
DATABASE_URL="postgresql://wa:PASSWORD@postgres:5432/wa_platform?connection_limit=5"
# Database yang SAMA untuk ai-knowledge (Go), tanpa parameter Prisma.
AI_DATABASE_URL="postgresql://wa:PASSWORD@postgres:5432/wa_platform?sslmode=disable"

# ---------- Keamanan ----------
# openssl rand -base64 32. Mengenkripsi token setiap nomor WA: kalau hilang
# atau berubah, semua nomor harus didaftarkan ulang. Simpan salinannya di
# luar server. Kalau memindahkan data lama, pakai kunci instalasi lama.
ENCRYPTION_KEY=""

# Sesi login dashboard.   openssl rand -base64 32
AUTH_SECRET=""

# ---------- Meta / WhatsApp Cloud API ----------
# Opsional: keduanya kini disimpan per koneksi di halaman Pengaturan.
# Isi hanya sebagai cadangan untuk install yang belum memindahkannya.
META_APP_SECRET=""
WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_VERSION="v21.0"

LOG_LEVEL="info"

# ---------- Basis pengetahuan & router AI (backend/ai-knowledge) ----------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-embedding-001"

# Kunci bersama dashboard <-> ai-knowledge (header X-Internal-API-Key).
# openssl rand -hex 32. Kalau memindahkan data lama, samakan dengan kunci lama
# supaya header yang tersimpan di endpoint AI tetap cocok.
AI_KNOWLEDGE_API_KEY=""

# Pengunci POST /documents/reset (menghapus SELURUH dokumen). Kosong = reset
# ditolak di produksi.
AI_ADMIN_SECRET_KEY=""

# Penyetelan router /route - kosongkan untuk memakai bawaan.
# Penjelasan tiap angka ada di backend/ai-knowledge/.env.example.
# ROUTE_MIN_SCORE=0.62
# ROUTE_MIN_MARGIN=0.02
# ROUTE_EXAMPLE_MIN=0.9
# ROUTE_EXAMPLE_HINT=0.8
# ROUTE_CHOOSER_MODEL="gemini-flash-lite-latest"
# ROUTE_CHOOSER_TIMEOUT=2.5
